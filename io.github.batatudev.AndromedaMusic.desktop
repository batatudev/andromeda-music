[Desktop Entry]
Version=1.0
Type=Application
Name=Andromeda Music
GenericName=Music Player & Ambient Video Visualizer
GenericName[pl]=Odtwarzacz muzyki i ambient wideo
Comment=Native music player with Navidrome, YouTube ambient video, and Hi-Fi streaming
